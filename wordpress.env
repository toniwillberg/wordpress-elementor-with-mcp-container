# WordPress site settings, used by the wp-setup service. Safe to commit.
# Secrets (passwords) live in .env.

# Used only on first install
WP_URL=http://localhost:8080
WP_TITLE="My Test X Site"
WP_LOCALE=en_US
WP_ADMIN_USER=siteXadmin
WP_ADMIN_EMAIL=admin@example.com
WP_BLOG_PUBLIC=0

# Space-separated plugins, installed and activated if missing. Each entry is either
# a wordpress.org slug, or folder=zip-url for plugins hosted elsewhere.
# emcp-tools (Elementor MCP) is not on wordpress.org: https://github.com/msrbuilds/elementor-mcp/releases
# mcp-adapter (official WordPress MCP) is not on wordpress.org: https://github.com/WordPress/mcp-adapter/releases
WP_PLUGINS=elementor essential-addons-for-elementor-lite seo-by-rank-math wp-optimize advanced-custom-fields emcp-tools=https://github.com/msrbuilds/elementor-mcp/releases/download/v3.17.1/emcp-tools-3.17.1.zip mcp-adapter=https://github.com/WordPress/mcp-adapter/releases/latest/download/mcp-adapter.zip

# wordpress.org theme slug, installed if missing and activated
WP_THEME=hello-elementor

# Space-separated plugin slugs, uninstalled and deleted if present (WordPress ships these by default)
WP_REMOVE_PLUGINS=akismet hello header-footer-elementor

# Applied on every `docker compose up`: open or closed
# closed = comments and pingbacks off for new posts and all existing posts
WP_COMMENTS=closed
