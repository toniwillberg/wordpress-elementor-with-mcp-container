# Secrets only. Copy to .env and fill in. Site settings live in wordpress.env.
DB_NAME=wordpress
DB_USER=wordpress
DB_PASSWORD=change-me
DB_ROOT_PASSWORD=change-me
WP_ADMIN_PASSWORD=change-me

# Application password for mcp-adapter (Basic auth user: MCP_APP_USER + this password)
MCP_APP_USER=siteXadmin
MCP_APP_PASSWORD=change-me